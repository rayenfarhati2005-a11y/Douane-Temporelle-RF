<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rf_bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Carte passeport -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rf_bg_card"
            android:elevation="8dp"
            android:padding="14dp">

            <!-- Photo / icône à gauche -->
            <ImageView
                android:id="@+id/img_passport_rf"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="0.3"
                android:background="@drawable/rf_bg_photo"
                android:clipToOutline="true"
                android:contentDescription="@string/passeport_temporel"
                android:scaleType="centerCrop"
                android:src="@drawable/rf_passport_photo" />

            <!-- Informations à droite -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:paddingStart="14dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/txt_titre_verif_rf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASSEPORT TEMPOREL"
                    android:textColor="@color/rf_accent_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <View
                    android:id="@+id/divider_verif_rf"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/txt_titre_verif_rf"
                    android:layout_marginTop="10dp"
                    android:background="@color/rf_input_stroke" />

                <TextView
                    android:id="@+id/txt_nom_verif_rf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/divider_verif_rf"
                    android:layout_marginTop="14dp"
                    android:text="Nom : "
                    android:textColor="@color/rf_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txt_age_verif_rf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_nom_verif_rf"
                    android:layout_marginTop="10dp"
                    android:text="Age temporel : "
                    android:textColor="@color/rf_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txt_motif_verif_rf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_age_verif_rf"
                    android:layout_marginTop="10dp"
                    android:text="Motif : "
                    android:textColor="@color/rf_text_primary"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_approuver_rf"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_below="@id/txt_motif_verif_rf"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/rf_btn_success"
                    android:stateListAnimator="@null"
                    android:text="Approuver le saut temporel"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_refuser_rf"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_below="@id/btn_approuver_rf"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/rf_btn_danger"
                    android:stateListAnimator="@null"
                    android:text="Refuser le saut"
                    android:textAllCaps="false"
                    android:textColor="@color/rf_danger"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
