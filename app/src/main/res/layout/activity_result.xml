<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_result_rf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rf_bg_screen"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/rf_bg_card_dark"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VERDICT"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.3" />

        <TextView
            android:id="@+id/txt_resultat_rf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Résultat du voyage"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_nouveau_rf"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rf_btn_light"
            android:stateListAnimator="@null"
            android:text="Nouveau voyageur"
            android:textAllCaps="false"
            android:textColor="@color/rf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
