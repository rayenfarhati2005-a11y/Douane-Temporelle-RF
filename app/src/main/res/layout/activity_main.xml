<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rf_bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- En-tête -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/txt_titre_rf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="DOUANE TEMPORELLE"
            android:textColor="@color/rf_accent"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Contrôle des voyageurs du temps"
            android:textColor="#B8C2E8"
            android:textSize="14sp" />

        <!-- Carte formulaire -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rf_bg_card"
            android:elevation="8dp"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil du voyageur"
                android:textColor="@color/rf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_nom_rf"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rf_bg_input"
                android:hint="Nom du voyageur"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/rf_text_primary"
                android:textColorHint="@color/rf_hint"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edt_naissance_rf"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rf_bg_input"
                android:hint="Année de Naissance"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/rf_text_primary"
                android:textColorHint="@color/rf_hint"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edt_destination_rf"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rf_bg_input"
                android:hint="Année de Destination"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/rf_text_primary"
                android:textColorHint="@color/rf_hint"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Motif du voyage"
                android:textColor="@color/rf_text_secondary"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinner_motif_rf"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/rf_bg_input"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_inspecter_rf"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/rf_btn_primary"
                android:stateListAnimator="@null"
                android:text="Inspecter le profil"
                android:textAllCaps="false"
                android:textColor="@color/rf_bg_start"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
